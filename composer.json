{
	"name": "phpgt/promise",
	"description": "Pleasantly work with asynchronous code.",
	"license": "MIT",

	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^12.1",
		"phpmd/phpmd": "^2.13",
		"squizlabs/php_codesniffer": "^3.7"
	},

	"autoload": {
		"psr-4": {
			"GT\\Promise\\": "./src",
			"Gt\\Promise\\": "./src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GT\\Promise\\Test\\": "./test/phpunit",
			"Gt\\Promise\\Test\\": "./test/phpunit"
		}
	},
	"keywords": [
		"promise",
		"async",
		"asynchronous",
		"concurrent",
		"concurrency",
		"then",
		"deferred",
		"w3c",
		"callback"
	],

	"scripts": {
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpstan": "vendor/bin/phpstan analyse --level 6 src --memory-limit 256M",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"test": [
			"@phpunit",
			"@phpstan",
			"@phpcs",
			"@phpmd"
		]
	},

	"config": {
		"platform": {
		}
	},

	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/phpgt"
		}
	]
}
